# Offer ladder service configuration (copy to .env). NO SECRETS HERE: mnemonics are read
# from mode-600 files; only their locations are configured.

# Kernel API. Empty = outbox mode (offers are built and stored, not posted).
# Expected stagenet kernel: https://stagenet.api-zswap.zkdojo.com (not deployed yet).
ZSWAP_API=

# wallet-per-slot (production: one maker wallet per slot) | single-wallet-pinned (test)
MODE=wallet-per-slot
LADDER_FILE=ladders/stagenet.json
TOKENS_FILE=deployments/stagenet.json

# Timing
OFFER_TTL_MINUTES=60
RECONCILE_SECONDS=60
EXPIRY_GRACE_SECONDS=5
RETRY_BASE_SECONDS=60
MAX_BUILDS_PER_TICK=0
WALLET_STAGGER_MS=5000
OUTBOX_RETENTION_HOURS=168

# Stagenet endpoints (defaults shown)
MN_NETWORK_ID=stagenet
MN_NODE_URL=https://rpc.stagenet.shielded.tools
MN_INDEXER_URL=https://indexer.stagenet.shielded.tools/api/v4/graphql
MN_INDEXER_WS_URL=wss://indexer.stagenet.shielded.tools/api/v4/graphql/ws
# Set by compose.yml to the bundled proof server:
# MN_PROOF_SERVER_URL=http://proof-server:6300

# Host-side (compose variables)
# SECRETS_DIR=~/.stagenet-offer-ladders
# STATUS_HOST_PORT=18080
# IMAGE_TAG=local
# FUNDING_WALLET_FILE_HOST=/path/to/funding-mnemonic-file   (compose.test.yml only)
