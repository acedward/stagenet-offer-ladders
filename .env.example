# Offer ladder service configuration (copy to .env). NO SECRETS HERE: mnemonics are read
# from mode-600 files; only their locations are configured.
# Keep comments on their own lines: Docker Compose reads `KEY=   # text` as the value "# text".

# Kernel API. Empty = outbox mode (offers are built and stored, not posted).
# Expected stagenet kernel: https://stagenet.api-zswap.zkdojo.com (not deployed yet).
ZSWAP_API=

# wallet-per-slot (production: one maker wallet per slot) | single-wallet-pinned (test)
MODE=wallet-per-slot
LADDER_FILE=ladders/stagenet.json
TOKENS_FILE=deployments/stagenet.json
# Journal and outbox (container paths; empty = /data/ladder.<mode>.journal.json and /data/outbox).
# Each ladder file gets its own: for the 00057 stock/USDC books (LADDER_FILE=ladders/stagenet.usdc.json)
# use JOURNAL_FILE=/data/ladder.books.journal.json and OUTBOX_DIR=/data/outbox-books.
JOURNAL_FILE=
OUTBOX_DIR=

# Timing
OFFER_TTL_MINUTES=60
RECONCILE_SECONDS=60
EXPIRY_GRACE_SECONDS=300
RETRY_BASE_SECONDS=60
MAX_BUILDS_PER_TICK=0
WALLET_STAGGER_MS=5000
OUTBOX_RETENTION_HOURS=168

# Safety (audit fixes)
# Upper bound = the network's real Merkle-root window (the kernel's status wins). Stagenet runs
# ledger 9, whose zswap roots live for global_ttl = 1,209,600 s = 14 days: 20160 minutes.
# (Ledger 7/8 kept roots for 1 hour; only there would 60 be right.)
ROOT_WINDOW_MINUTES=20160
# Re-post (same bytes) a submitted offer the kernel still does not list after this long.
SUBMIT_CONFIRM_SECONDS=300
# A longer proof makes the process exit (the restart policy recovers).
BUILD_TIMEOUT_SECONDS=300
# Empty = no node-version guard.
EXPECTED_NODE_VERSION=2.0.0-d9729c13
VERSION_CHECK_EVERY_TICKS=10
# Empty = max(30 min, 3 x reconcile + 2 x build timeout).
WATCHDOG_SECONDS=
# true only after reconciling a quarantined journal.
JOURNAL_RESET=false
# The fresh journal's own token (fresh-xxxxxxxx, printed in the log and on /status): set it
# ONCE for the first start of a new journal, then empty it again.
FRESH_START_ACK=
# Only for a lock whose holder you confirmed is not running (else wait ~90 s):
# BREAK_LOCK=<instance>

# Stagenet endpoints (defaults shown)
MN_NETWORK_ID=stagenet
MN_NODE_URL=https://rpc.stagenet.shielded.tools
MN_INDEXER_URL=https://indexer.stagenet.shielded.tools/api/v4/graphql
MN_INDEXER_WS_URL=wss://indexer.stagenet.shielded.tools/api/v4/graphql/ws
# Set by compose.yml to the bundled proof server:
# MN_PROOF_SERVER_URL=http://proof-server:6300

# Host-side (compose variables)
# SECRETS_DIR=~/.stagenet-offer-ladders          (makers.json is mounted read-only from here)
# STATE_DIR_HOST=~/.stagenet-offer-ladders/state (journal, outbox, locks: never delete while offers are live)
# LADDER_MEM_LIMIT=4g
# STATUS_HOST_PORT=18080
# IMAGE_TAG=local
# FUNDING_WALLET_FILE_HOST=/path/to/funding-mnemonic-file   (compose.test.yml only)
